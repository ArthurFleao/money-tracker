# Copy to .env.local (git-ignored) and adjust. Every variable must be listed here
# with a dummy value and a comment. Never put real secrets in this file.
# Only variables prefixed with VITE_ are exposed to the browser bundle — and
# everything in the bundle is public, so never use VITE_ for real secrets.

# Data adapter: dexie (default, IndexedDB) | memory (demo/tests) | firebase (Phase 8).
# Used from Phase 2. With dexie, no other variable is needed.
VITE_DATA_ADAPTER=dexie

# --- Firebase (Phase 8) -----------------------------------------------------
# Firebase web config values are identifiers, not secrets (see docs/SECURITY.md),
# but keep them out of git so forks point at their own project.
# VITE_FIREBASE_API_KEY=your-api-key
# VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
# VITE_FIREBASE_PROJECT_ID=your-project-id
# VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
# VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
# VITE_FIREBASE_APP_ID=1:000000000000:web:0000000000000000
# VITE_FIREBASE_APP_CHECK_SITE_KEY=your-recaptcha-site-key
# Connect the SDKs to the local Emulator Suite instead of production.
# VITE_USE_FIREBASE_EMULATORS=false
